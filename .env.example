# Server & Admin Security Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
ADMIN_PASSWORD=your_secure_admin_password

# Gmail IMAP Credentials (Required for live email listening)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create a new App Password (e.g. name it "eSewa Gateway")
# 4. Paste the 16-character password below (without spaces)

GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_POLL_INTERVAL=3

# eSewa Receiver Details
ESEWA_SENDER_EMAIL=donotreply@esewa.com.np
ESEWA_ID=your_esewa_id_or_mobile
ESEWA_NAME=Your Name

# Payment & Micro-Discount Matching Rules
ORDER_EXPIRY_MINUTES=10
DISCOUNT_MIN_OFFSET=0.01
DISCOUNT_MAX_OFFSET=0.50

# Outbound Webhook Integration (Optional)
WEBHOOK_URL=
WEBHOOK_SECRET=
